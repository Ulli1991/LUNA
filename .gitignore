# ───────────────────────────── Python / build ────────────────────────────
__pycache__/
*.py[cod]
*$py.class
# packaging / build artifacts (from `pip install -e .`, `python -m build`)
*.egg-info/
build/
dist/
.eggs/
# local copy of template_config.py (per-run knobs) — root only, so it does NOT
# swallow module configs like amr/config.py
/config.py

# ──────────────────────── Simulation data & output ───────────────────────
*.hdf5
*.h5
# snapshot files + the snapshots* output symlinks
snap*
# Output dirs are symlinks into scratch (/ptmp). A no-slash pattern matches a
# symlink too (a "name/" pattern would not), so these stay untracked.
reference
checkpoints

# ───────────────────────── Logs / job output / profiling ─────────────────
# NB: extension-anchored on purpose. The old `*out*`/`*err*` substring rules
# silently untracked ANY path containing those letters (bit us once with
# pm_force_1overr2.png; would swallow a future utils/error_norms.py too).
*.log
job.out*
job.err*
job_*
*.out
*.err
smoke_out/
*.nsys-rep
*.sqlite
core.*

# ────────────────────────────────── Figures ──────────────────────────────
# code_paper_figs/ = the ONE tracked figure+data set (paper/README figures and
# the reference .npz/.csv the plot scripts read back). figures/ = scratch
# output of the plot scripts, never tracked.
# NOTE: the png whitelist must stay AFTER the *.out/*.err rules above.
*.png
!code_paper_figs/*.png
figures/

# ───────────────────────────────── Editor / OS ───────────────────────────
*.swp
*.swo
.DS_Store
Thumbs.db

# ──────────────────────────── Virtual environments ───────────────────────
venv/
env/
*.venv/

# ───────────────────────── Paper / LaTeX (ship the PDF) ───────────────────
paper.tex
paper.tex.bak
*.aux
amr_integration_brief.md

# ────────────────── SLURM submit scripts (only examples shipped) ──────────
# stray top-level shell scripts
/*.sh
submit/*
!submit/examples/

# ──────────────── viper scaling / GPU-scaling debug work tree ─────────────
# Run outputs, repro scripts, and the launch harness are viper-specific
# scratch (hardcoded /viper paths). The results that ship are the figures in
# code_paper_figs/ + figures/scaling_fp64_amd_data.csv (regenerated by
# scripts/validation/plots/scaling_plot_fp64.py).
/scaling/

# site-specific SLURM launchers stay local; the repo ships two examples in
# submit/examples/ (one NVIDIA, one AMD)
scripts/submit_*.sh
scripts/validation/plots/fig3_ramses_analog.py
scripts/validation/plots/shock_density_singles.py
scripts/validation/plots/workflow_figs.py
scripts/validation/runs/m1_3d_check.py
scripts/validation/runs/sedov3d_amr_cooling_run.py
scripts/movies/

# redundant _amd figure variants (README uses the plain names)
code_paper_figs/scaling_weak_fp64_amd.png
code_paper_figs/scaling_strong_fp64_amd.png
.claude/
