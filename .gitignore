# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
config.py

# HDF5 output files
*.hdf5
*.png
# But keep validation figures embedded in the README and paper-staging copies
!figures/*.png
!paper_figures/*.png

# Log files
*.log
job.out*
job.err*
snap*
job_*
*.swp
*.swo
*out*
*err*
# Re-assert the figure whitelist LAST: the broad *out*/*err* log rules above
# otherwise re-ignore PNGs whose names merely contain those substrings
# (e.g. pm_force_1ov[err]2.png), silently dropping README/paper figures.
!figures/*.png
!paper_figures/*.png
*.nsys-rep
*.sqlite

# Virtual environment
venv/
env/
*.venv/

# OS-specific files
.DS_Store
Thumbs.db

# bash scripts in main
/*.sh

# Simulation output dirs — now symlinks into /ptmp (move_all_to_ptmp.sh).
# No trailing slash: a "name/" pattern matches only real directories, NOT a
# symlink, so these would otherwise keep showing up as untracked.
# (snapshots* are already covered by the snap* rule above.)
reference
checkpoints

# Paper figure staging: ship the PNGs, not the tex source
paper_figures/*.tex
paper.tex
amr_integration_brief.md
flowchart_luna.tex
paper.tex.bak
