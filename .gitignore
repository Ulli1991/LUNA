# ───────────────────────────── Python / build ────────────────────────────
__pycache__/
*.py[cod]
*$py.class
# packaging / build artifacts (from `pip install -e .`, `python -m build`)
*.egg-info/
build/
dist/
.eggs/
# local copy of template_config.py (per-run knobs) — root only, so it does NOT
# swallow module configs like amr/config.py
/config.py

# ──────────────────────── Simulation data & output ───────────────────────
*.hdf5
*.h5
# snapshot files + the snapshots* output symlinks
snap*
# Output dirs are symlinks into scratch (/ptmp). A no-slash pattern matches a
# symlink too (a "name/" pattern would not), so these stay untracked.
reference
checkpoints

# ───────────────────────── Logs / job output / profiling ─────────────────
*.log
job.out*
job.err*
job_*
*out*
*err*
*.nsys-rep
*.sqlite
core.*

# ────────────────────────────────── Figures ──────────────────────────────
# Only the canonical paper/README figures are tracked; figures/ is scratch.
# NOTE: this whitelist must stay AFTER the broad *out*/*err* rules above,
# otherwise PNGs whose names merely contain those substrings get re-ignored
# (e.g. pm_force_1ov[err]2.png).
*.png
!code_paper_figs/*.png

# ───────────────────────────────── Editor / OS ───────────────────────────
*.swp
*.swo
.DS_Store
Thumbs.db

# ──────────────────────────── Virtual environments ───────────────────────
venv/
env/
*.venv/

# ───────────────────────── Paper / LaTeX (ship the PDF) ───────────────────
paper.tex
paper.tex.bak
*.aux
amr_integration_brief.md

# ────────────────── SLURM submit scripts (only examples shipped) ──────────
# stray top-level shell scripts
/*.sh
submit/*
!submit/examples/

# ──────────────── viper scaling / GPU-scaling debug work tree ─────────────
# Run outputs, repro scripts, and the launch harness are viper-specific
# scratch (hardcoded /viper paths). The results that ship are the figures in
# code_paper_figs/ + figures/scaling_fp64_amd_data.csv (regenerated by
# scripts/validation/plots/scaling_plot_fp64.py).
/scaling/

# viper-specific scaling artifacts (ignore for now)
figures/scaling_fp64_amd_data.csv
scripts/submit_viper_apu_2gpu.sh

# redundant _amd figure variants (README uses the plain names)
code_paper_figs/scaling_weak_fp64_amd.png
code_paper_figs/scaling_strong_fp64_amd.png
