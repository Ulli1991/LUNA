# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
config.py

# HDF5 output files
*.hdf5
*.png
# But keep validation figures embedded in the README and paper-staging copies
!figures/*.png
!paper_figures/*.png

# Log files
*.log
job.out*
job.err*
snap*
job_*
*.swp
*.swo
*out*
*err*
*.nsys-rep
*.sqlite

# Virtual environment
venv/
env/
*.venv/

# OS-specific files
.DS_Store
Thumbs.db

# bash scripts in main
/*.sh

# AthenaK reference simulation outputs (large binary dumps, regenerable)
reference/

# Paper figure staging: ship the PNGs, not the tex source
paper_figures/*.tex
